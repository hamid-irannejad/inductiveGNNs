def fmt_p(p): return "<0.001" if p < 0.001 else f"{p:.3f}"
order = ["Accuracy", "MCC", "Macro AUROC", "Macro AUPRC"] + [f"{m} - {c}" for m in ["F1", "AUROC", "AUPRC"] for c in CLASSES]
