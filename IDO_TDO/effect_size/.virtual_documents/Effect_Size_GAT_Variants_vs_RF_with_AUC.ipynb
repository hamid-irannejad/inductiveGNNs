for v, r in res.items():
    for fam, g in r.groupby("Family"):
        print(f"{v:8s} {fam:34s} n={len(g):2d} | raw p<.05: {int((g.p<.05).sum()):2d} | Holm (family): {int(g.sig_holm.sum()):2d} | "
